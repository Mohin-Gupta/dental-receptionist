# syntax=docker/dockerfile:1.7

# Keep this aligned with the runtime Dockerfile. Production CI should override
# it with the same approved immutable image digest used for the API and worker.
ARG NODE_IMAGE=node:24.16.0-bookworm-slim

FROM ${NODE_IMAGE} AS migration

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Prisma CLI is a development dependency by design. This one-shot image
# intentionally retains it; the long-lived Dockerfile removes the optional
# peer copy after generating and smoke-loading @prisma/client.
ENV NODE_ENV=development

COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node prisma ./prisma

RUN npm ci --include=dev \
    && npm cache clean --force

ENV NODE_ENV=production

USER node

CMD ["./node_modules/.bin/prisma", "migrate", "deploy"]
